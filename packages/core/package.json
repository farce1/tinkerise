{
  "name": "@tinkerise/core",
  "type": "module",
  "version": "0.2.5",
  "description": "Core business logic for tinkerise — scaffolder registry, enhancement system, config, and presets",
  "license": "MIT",
  "homepage": "https://github.com/farce1/tinkerise",
  "repository": {
    "type": "git",
    "url": "https://github.com/farce1/tinkerise.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/farce1/tinkerise/issues"
  },
  "keywords": [
    "tinkerise",
    "scaffolding",
    "enhancements",
    "registry",
    "project-setup"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tinkerise/shared": "^0.2.5",
    "ci-info": "^4.4.0",
    "deepmerge-ts": "^7.1.5",
    "diff": "^8.0.3",
    "execa": "^9.6.1",
    "jiti": "^2.6.1",
    "picocolors": "^1.1.1",
    "semver": "^7.7.4",
    "which": "^6.0.1",
    "zod": "^4.3.6"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/semver": "^7.7.1",
    "@types/which": "^3.0.4",
    "tsup": "^8.4"
  }
}
