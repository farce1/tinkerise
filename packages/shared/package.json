{
  "name": "@tinkerise/shared",
  "type": "module",
  "version": "0.0.0",
  "description": "Shared types, Zod schemas, and constants for the tinkerise monorepo",
  "keywords": ["tinkerise", "shared", "types", "schemas", "utilities"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/farce1/tinkerise.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/farce1/tinkerise",
  "bugs": {
    "url": "https://github.com/farce1/tinkerise/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsup": "^8.4"
  },
  "engines": {
    "node": ">=20.11.0"
  }
}
