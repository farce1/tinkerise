{
  "version": 1,
  "suite": "completion-matrix",
  "description": "Phase 34 shell completion conformance",
  "scenarios": [
    {
      "id": "bash-top-level-subcommand",
      "name": "bash: tinkerise <TAB> emits all top-level subcommands",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise ",
      "expectedCandidatesInclude": ["list", "add", "doctor", "completion"],
      "expectExitOk": true
    },
    {
      "id": "bash-flag-name-at-depth",
      "name": "bash: tinkerise web next my-app --<TAB> emits global flag names",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise web next my-app --",
      "expectedCandidatesInclude": ["--package-manager"],
      "expectExitOk": true
    },
    {
      "id": "bash-dynamic-value-presets",
      "name": "bash: tinkerise --preset <TAB> looks up presets via mocked __complete",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise --preset ",
      "expectedCandidates": ["my-stack", "team-defaults"],
      "expectExitOk": true,
      "mockBin": {
        "__complete": {
          "presets": ["my-stack", "team-defaults"]
        }
      }
    },
    {
      "id": "bash-static-enum-completion",
      "name": "bash: tinkerise completion <TAB> emits static shell enum",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise completion ",
      "expectedCandidates": ["bash", "zsh", "fish"],
      "expectExitOk": true
    },
    {
      "id": "bash-negative-unknown-command",
      "name": "bash: tinkerise bogusbogusbogus <TAB> yields empty candidate set (no false positives)",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise bogusbogusbogus ",
      "expectedCandidates": [],
      "expectExitOk": true
    },
    {
      "id": "bash-tk-alias",
      "name": "bash: tk <TAB> emits same top-level candidates as tinkerise (D-05 dual-binary)",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tk ",
      "expectedCandidatesInclude": ["list", "add", "doctor", "completion"],
      "expectExitOk": true
    },
    {
      "id": "bash-failing-mockbin-preset",
      "name": "bash: tinkerise --preset <TAB> with failing __complete yields empty candidates, no stderr leak (D-19)",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise --preset ",
      "expectedCandidates": [],
      "expectExitOk": true,
      "mockBin": {
        "__complete": {
          "presets": "FAIL"
        }
      }
    },
    {
      "id": "bash-dynamic-value-scaffolders-web",
      "name": "bash: tinkerise web <TAB> looks up web scaffolders via mocked __complete (CR-01 closure)",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise web ",
      "expectedCandidates": ["next", "vite", "astro"],
      "expectExitOk": true,
      "mockBin": {
        "__complete": {
          "scaffolders:web": ["next", "vite", "astro"]
        }
      }
    },
    {
      "id": "bash-negative-unknown-category",
      "name": "bash: tinkerise notacategory <TAB> yields empty candidates (root-positional dispatch only matches known categories)",
      "requirements": ["CLI-09", "CLI-10"],
      "shell": "bash",
      "partialCommand": "tinkerise notacategory ",
      "expectedCandidates": [],
      "expectExitOk": true
    },

