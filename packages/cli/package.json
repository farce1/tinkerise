{
  "name": "@tinkerise/cli",
  "type": "module",
  "version": "0.2.2",
  "description": "CLI entry point for tinkerise — commands, prompts, and user-facing output",
  "license": "MIT",
  "homepage": "https://github.com/farce1/tinkerise",
  "repository": {
    "type": "git",
    "url": "https://github.com/farce1/tinkerise.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/farce1/tinkerise/issues"
  },
  "keywords": [
    "tinkerise",
    "cli",
    "scaffolding",
    "project-generator",
    "developer-tools"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "tinkerise": "./dist/index.js",
    "tk": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "test": "vitest run",
    "test:conformance": "vitest run tests/conformance/runtime-error-matrix.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.0.1",
    "@tinkerise/core": "^0.2.2",
    "@tinkerise/shared": "^0.2.2",
    "commander": "^13.0",
    "picocolors": "^1.1",
    "semver": "^7.7.4"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/semver": "^7.7.1",
    "execa": "^9.6.1",
    "tsup": "^8.4"
  }
}
