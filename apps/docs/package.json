{
  "name": "@tinkerise/docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "bun run docs:changelog && bun run docs:schemas && astro build",
    "preview": "astro preview",
    "docs:reference": "node ./scripts/generate-command-reference.mjs",
    "docs:changelog": "node ./scripts/generate-changelog.mjs",
    "docs:schemas": "tsx ./scripts/generate-json-schemas.ts",
    "docs:smoke": "node ./scripts/smoke-production-docs.mjs"
  },
  "dependencies": {
    "astro": "^5.5.0",
    "@astrojs/starlight": "^0.37.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@tinkerise/core": "workspace:*",
    "@tinkerise/shared": "workspace:*",
    "tsx": "^4.19.2"
  }
}
